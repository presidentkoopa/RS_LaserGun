// ADDPlayerClasses / ADDEventHandlers, both additive on purpose.
//
// The non-Add forms REPLACE the lists outright. `PlayerClasses` here would
// wipe every class of whatever mod this is loaded alongside -- RS_Main ships
// nine of them -- and `EventHandlers` would unregister that mod's handlers.
// A drop-in weapon must add to a game, never redefine it.
gameinfo
{
	AddPlayerClasses = "LNC_LaserMarine"

	// ALL THREE. Only LNC_Startup was ever listed here, which meant
	// LNC_BurnHandler and LNC_DropHandler existed, compiled, and never ran:
	// GZDoom does not auto-register EventHandler subclasses. Burning deaths
	// and the 2% core drop were both dead from the day they were written.
	AddEventHandlers = "LNC_BurnHandler", "LNC_LanceWorld", "LNC_DropHandler"
}
